{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-monthly.internal/schema/monthly-data-1.0.json",
  "title": "Monthly report normalized data 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "report_month", "status", "producer", "scope", "windows", "metrics", "tables", "missing"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "report_month": {"$ref": "#/$defs/month"},
    "status": {"enum": ["complete", "partial"]},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["data_source_id", "data_source_revision", "adapter_version", "source_snapshot_id", "generated_at", "window_evidence"],
      "properties": {
        "data_source_id": {"$ref": "#/$defs/id"},
        "data_source_revision": {"type": "integer", "minimum": 1},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "source_schema_version": {"type": "string", "maxLength": 100},
        "source_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "calculation_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "generated_at": {"type": "string", "format": "date-time"},
        "window_evidence": {"enum": ["source", "operator-confirmed"]}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "region", "population"],
      "properties": {
        "platform": {"type": "string", "minLength": 1, "maxLength": 120},
        "region": {"type": "string", "minLength": 1, "maxLength": 120},
        "population": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "windows": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/window"}},
    "metrics": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/metric"}},
    "tables": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/table"}},
    "missing": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/missing"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,159}$"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "date": {"type": "string", "format": "date"},
    "value": {"type": ["number", "string", "boolean", "null"]},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "start", "end", "timezone", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["monthly", "release_d0_d13", "custom"]},
        "start": {"$ref": "#/$defs/date"},
        "end": {"$ref": "#/$defs/date"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 300},
        "observed_as_of": {"$ref": "#/$defs/date"},
        "release_date": {"$ref": "#/$defs/date"}
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "calculation_id": {"type": "string", "maxLength": 200},
        "calculation_version": {"type": "string", "maxLength": 100},
        "transform": {"type": "string", "maxLength": 300}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "type", "value", "unit", "window_id", "origin"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "type": {"enum": ["count", "money", "ratio", "rank", "text", "date", "boolean"]},
        "value": {"$ref": "#/$defs/value"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 50},
        "window_id": {"$ref": "#/$defs/id"},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "column": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "type", "unit", "source_field"],
      "properties": {
        "key": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "type": {"enum": ["count", "money", "ratio", "rank", "text", "date", "boolean"]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 50},
        "source_field": {"type": "string", "minLength": 1, "maxLength": 500},
        "window_id": {"$ref": "#/$defs/id"},
        "calculation_id": {"type": "string", "maxLength": 200},
        "calculation_version": {"type": "string", "maxLength": 100}
      }
    },
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "window_id", "row_key", "source_path", "columns", "rows"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "window_id": {"$ref": "#/$defs/id"},
        "row_key": {"$ref": "#/$defs/id"},
        "source_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "columns": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/column"}},
        "rows": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "values"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 300}, "values": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}}}}}
      }
    },
    "missing": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "reason", "detail"],
      "properties": {
        "path": {"type": "string", "pattern": "^/(metrics|tables)/", "maxLength": 500},
        "reason": {"enum": ["not_provided", "window_unavailable", "credential_expired", "ambiguous_definition", "source_error"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
