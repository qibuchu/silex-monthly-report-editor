{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateSourceBinding 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "template_revision", "sources", "mappings"],
  "properties": {
    "template_id": {"type": "string", "minLength": 1},
    "template_revision": {"type": "integer", "minimum": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_revision", "role", "native_schema_id", "native_schema_version"], "properties": {"source_id": {"type": "string", "minLength": 1}, "source_revision": {"type": "integer", "minimum": 1}, "role": {"enum": ["primary", "supplementary"]}, "native_schema_id": {"type": "string", "minLength": 1}, "native_schema_version": {"type": "string", "minLength": 1}}}},
    "mappings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["target_object_id", "source_id", "native_path"], "properties": {"target_object_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "native_path": {"type": "string", "minLength": 1, "description": "来源原生 JSON 字段路径或工作表/列标识"}, "unit": {"type": "string"}, "window_rule": {"type": "string"}}}}
  }
}
